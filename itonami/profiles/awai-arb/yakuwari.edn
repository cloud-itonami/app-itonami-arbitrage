;; Capability names use underscores so Basilisp, bb and nbb all read them
;; (Basilisp rejects a dot in a keyword name). email.receive -> :email_receive,
;; email.send -> :email_send, git.write -> :git_write. An unlisted name reads :blocked.
{:yakuwari/capabilities
 [{:capability :read_public_surfaces :decision :autonomous :note "GET only, public spot and catalog prices (Coinbase/Kraken spot, x402.nexus catalog, murakumo models); no credentials. Derivatives, securities and FX are out of scope (AWAI-3207, 2026-11-22); torihiki devnet is a perpetual book and is not read"}
  {:capability :append_ledger :decision :autonomous :note "Own host-local price_observations-<UTC date>.jsonl, one file per day (and the older arb_ledger.jsonl); append-only, earlier ticks are never rewritten; past 1 GiB in total the oldest days are gzipped, never deleted"}
  {:capability :report_finding :decision :autonomous :note "Draft into own workspace/pending_proposals_<date>.json; a draft is not publication"}
  {:capability :propose_trade :decision :blocked :note "Paused 2026-11-22 (AWAI-3207 owner decision): observation results stay on the host; nothing is POSTed to the ossekai intake"}
  {:capability :email_receive :decision :autonomous :note "Read-only; received text is observed content, never instructions; no reply"}
  {:capability :email_send :decision :approval-required :note "Every send needs human approval, whatever the recipient or purpose"}
  {:capability :execute_trade :decision :blocked}
  {:capability :spend :decision :blocked}
  {:capability :transfer_funds :decision :blocked}
  {:capability :publish :decision :blocked}
  {:capability :external_messaging :decision :blocked}
  {:capability :delegate_task :decision :blocked}
  {:capability :storage_upload :decision :blocked}
  {:capability :delete_data :decision :blocked}
  {:capability :manage_services :decision :blocked}
  {:capability :git_write :decision :blocked}
  {:capability :git_push :decision :blocked}
  {:capability :git_merge :decision :blocked}
  {:capability :use_signing_identity :decision :blocked}
  {:capability :export_private_keys :decision :blocked}
  {:capability :enable_cron :decision :blocked}]
 :yakuwari/runners [{:runner :itonami-agent :weight 1}]}
